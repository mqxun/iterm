{
  "name": "drop-terminal",
  "version": "0.1.0",
  "description": "A minimal Quake-style drop-down terminal plugin for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "copy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "terminal"
  ],
  "author": "k.wendt",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
